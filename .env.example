COMPOSE_PROJECT_NAME=vue-storefront-api

# Uncomment to read the VSF catalog from the Magento project's OpenSearch engine
# instead of running `os1` here, after copying
# `docker-compose.shared-search.yml.example` to `docker-compose.shared-search.yml`.
#COMPOSE_FILE=docker-compose.yml:docker-compose.override.yml:docker-compose.shared-search.yml

LETSENCRYPT_EMAIL=

VS_ENV=dev
LOG_LEVEL=warn
LOG_COLORIZE=true
LOG_HTTP_FORMAT='[:date[clf]] - :response-time-in-seconds[4] - :status ":method :url HTTP/:http-version" :req[Content-Length] :res[content-length] -- ":referrer" :remote-addr - - ":user-agent" ":req[x-forwarded-for]" "TraceID: :req[x-amzn-trace-id]" "InstanceID: :req[x-instance-id]" "AppVersion: :req[x-app-version]"'

# When reaching the max old space size, Node.js will increase efforts to free up memory, but if it fails, it will crash the instance.
# Also, this limits only the old space size, not the total memory usage of the Node.js process.
# Set this slightly above NODEJS_INSTANCE_MAX_MEMORY — close enough to increase GC pressure, but high enough to allow PM2 to restart the process gracefully.
NODEJS_INSTANCE_MAX_OLD_SPACE=450
# Memory usage threshold after which PM2 will restart the instance
NODEJS_INSTANCE_MAX_MEMORY=400M
# Controls how often (in ms) PM2 checks memory usage of each instance
PM2_WORKER_INTERVAL=5000
# Should be higher than the load balancer keep-alive value
NODEJS_KEEP_ALIVE_TIMEOUT=61000


AUTH_HASH_SECRET=f3e4954c-cb74-48db-86f3-af63e0d2df1c
OBJ_HASH_SECRET=3f99c46e-bb30-4305-9eb5-6e8de4cf98c5
CACHE_INVALIDATION_KEY=97794daa3280

MAGENTO_USER_NAME=
MAGENTO_USER_PASSWORD=

MAGENTO_CONSUMER_KEY=
MAGENTO_CONSUMER_SECRET=
MAGENTO_ACCESS_TOKEN=
MAGENTO_ACCESS_TOKEN_SECRET=

# Store hosts are <brand>.<api|magento>.store.${STORE_ZONE}. Replace [name]. The one local
# VSF UI keeps ui.store.${STORE_ZONE}; staging (st.budsies.com) has <brand>.ui.store hosts.
STORE_ZONE=budsies.[name].team.gorbunov.studio

PETSIES_DOMAIN=petsies.api.store.${STORE_ZONE}
PETSIES_VSF_DOMAIN=ui.store.${STORE_ZONE}
PETSIES_MAGENTO_DOMAIN=petsies.magento.store.${STORE_ZONE}
PETSIES_STORE_ID=3
PETSIES_STORE_CODE=petsies_store
PETSIES_API_USER_AGENT=vue-storefront-api_petsies
PETSIES_STORYBLOK_SPACE_ID=
PETSIES_STORYBLOK_TOKEN=

BUDSIES_DOMAIN=budsies.api.store.${STORE_ZONE}
BUDSIES_VSF_DOMAIN=ui.store.${STORE_ZONE}
BUDSIES_MAGENTO_DOMAIN=budsies.magento.store.${STORE_ZONE}
BUDSIES_STORE_ID=1
BUDSIES_STORE_CODE=default
BUDSIES_API_USER_AGENT=vue-storefront-api_budsies
BUDSIES_STORYBLOK_SPACE_ID=
BUDSIES_STORYBLOK_TOKEN=

BULKORDERS_DOMAIN=bulkorders.api.store.${STORE_ZONE}
BULKORDERS_VSF_DOMAIN=ui.store.${STORE_ZONE}
BULKORDERS_MAGENTO_DOMAIN=bulkorders.magento.store.${STORE_ZONE}
BULKORDERS_STORE_ID=5
BULKORDERS_STORE_CODE=bulkorders_store
BULKORDERS_API_USER_AGENT=vue-storefront-api_bulkorders
BULKORDERS_STORYBLOK_SPACE_ID=
BULKORDERS_STORYBLOK_TOKEN=

WAGGABLES_DOMAIN=waggables.api.store.${STORE_ZONE}
WAGGABLES_VSF_DOMAIN=ui.store.${STORE_ZONE}
WAGGABLES_MAGENTO_DOMAIN=waggables.magento.store.${STORE_ZONE}
WAGGABLES_STORE_ID=4
WAGGABLES_STORE_CODE=waggables_store
WAGGABLES_API_USER_AGENT=vue-storefront-api_waggables
WAGGABLES_STORYBLOK_SPACE_ID=
WAGGABLES_STORYBLOK_TOKEN=

STORYBLOK_MANAGEMENT_TOKEN=
STORYBLOK_HOOK_SECRET=
STORYBLOK_SYNC_DATASOURCES=false

AMAZONPAY_SANDBOX=
AMAZONPAY_ACCESS_KEY=
AMAZONPAY_SECRET_KEY=
AMAZONPAY_SELLER_ID=
AMAZONPAY_ENDPOINT=

BRAINTREE_MODE=
BRAINTREE_MERCHANT_ID=
BRAINTREE_PUBLIC_KEY=
BRAINTREE_PRIVATE_KEY=
